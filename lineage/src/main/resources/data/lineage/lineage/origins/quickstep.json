      "quests": [
        { "id": "witches", "type": "kill", "entity": "minecraft:witch", "amount": 16,
          "description": "Defeat 16 Witches" },
        { "id": "rods", "type": "hold_item", "item": "minecraft:lightning_rod", "amount": 24,
          "description": "Carry 24 Lightning Rods" },
        { "id": "air_time", "type": "condition_time", "condition": "airborne", "seconds": 600,
          "description": "Spend 10 minutes airborne" }
      ],
      "abilities": [
        { "id": "storm_surge", "type": "dash", "name": "Storm Surge",
