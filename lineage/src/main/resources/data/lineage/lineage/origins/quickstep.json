          "target": "nearby", "radius": 4.5, "cooldown": 12, "hunger_cost": 2,
          "sound": "minecraft:block.respawn_anchor.charge" }
      ]
    },
    {
      "id": "stormrunner", "name": "Stormrunner",
      "description": "You outrun arrows and climb the air on a rolling thunderhead.",
