{
  "name": "Quickstep",
  "description": "A living storm-runner. Build momentum, master the storm, and ascend as its lightning god.",
  "icon": "minecraft:lightning_rod",
  "impact": 3,
  "abilities": [
    {
      "id": "quickstep_speed", "type": "attribute", "name": "Quickstep",
      "description": "Move 18% faster.", "icon": "minecraft:sugar",
      "attribute": "minecraft:generic.movement_speed", "amount": 0.18, "operation": "multiply_base"
    },
    {
      "id": "storm_toughness", "type": "damage_modifier", "name": "Storm-Tough",
      "description": "Take 20% less projectile damage.", "icon": "minecraft:shield",
      "damage_type": "#minecraft:is_projectile", "multiplier": 0.8
    },
    {
      "id": "nimble_landing", "type": "damage_modifier", "name": "Nimble Landing",
      "description": "Ignore fall damage.", "icon": "minecraft:feather",
      "damage_type": "minecraft:fall", "multiplier": 0
    },
    {
      "id": "static_dash", "type": "dash", "name": "Static Dash",
      "description": "Snap forward in a burst of blue-white static.", "icon": "minecraft:feather",
      "strength": 1.65, "upward": 0.12, "cooldown": 3, "hunger_cost": 1,
      "sound": "minecraft:entity.player.attack.sweep"
    },
    {
      "id": "static_burst", "type": "active_effect", "name": "Static Burst",
      "description": "Charge yourself with Speed for four seconds.", "icon": "minecraft:glowstone_dust",
