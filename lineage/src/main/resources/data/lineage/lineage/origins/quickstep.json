      "icon": "minecraft:amethyst_shard",
      "quests": [
        { "id": "creepers", "type": "kill", "entity": "minecraft:creeper", "amount": 24,
          "description": "Defeat 24 Creepers" },
        { "id": "sprint_time", "type": "condition_time", "condition": "sprinting", "seconds": 1800,
          "description": "Sprint for 30 minutes total" },
        { "id": "copper", "type": "hold_item", "item": "minecraft:copper_ingot", "amount": 32,
          "description": "Carry 32 Copper Ingots" }
      ],
      "abilities": [
        { "id": "charged_speed", "type": "attribute", "name": "Charged Legs",
          "description": "Another 10% movement speed.", "icon": "minecraft:lightning_rod",
          "attribute": "minecraft:generic.movement_speed", "amount": 0.10, "operation": "multiply_base" },
        { "id": "runner_haste", "type": "effect", "name": "Runner's Focus",
